<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <NoWarn>CA1416;CA2022;CA2200</NoWarn>
    <Version>1.0.2</Version>
    <Authors>OpenXmlDev</Authors>
    <Description>Open XML PowerTools is a set of productivity tools for creating and manipulating Open XML documents.</Description>
    <RepositoryUrl>https://github.com/OpenXmlDev/Open-Xml-PowerTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/OpenXmlDev/Open-Xml-PowerTools</PackageProjectUrl>
    <License>MIT</License>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.2" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
</Project>

